    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "velite": "^0.2.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
